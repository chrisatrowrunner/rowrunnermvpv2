# RowRunner — environment configuration
#
# Copy to `.env` and fill in. Vite only exposes vars prefixed with VITE_ to the
# client. Anything secret (service-role keys, printer tokens) belongs on the
# Express edge server, NOT here.

# Supabase project (used by src/lib/orders.ts when wired up)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Which venue this build serves (menus/seating are venue-scoped)
VITE_VENUE_ID=centreville-bank-stadium
