# RowRunner (fan app) — environment configuration
#
# Copy to `.env` and fill in. Vite only exposes vars prefixed with VITE_ to the
# client. The anon key is safe to expose (public, RLS-gated); never put the
# service_role key here.
#
# submitOrder() in src/lib/orders.ts uses Supabase when the two VITE_SUPABASE_*
# vars are set, otherwise it POSTs to the local edge server (VITE_EDGE_URL).

# ── Supabase (the shared backend) ────────────────────────────
# Dashboard ▸ Project Settings ▸ API:
#   VITE_SUPABASE_URL      = "Project URL"
#   VITE_SUPABASE_ANON_KEY = "Project API keys ▸ anon public"
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Edge-server fallback (ignored when Supabase is set)
# VITE_EDGE_URL=http://localhost:4000

# Which venue this build serves (menus/seating are venue-scoped)
VITE_VENUE_ID=nyc-tech-week
